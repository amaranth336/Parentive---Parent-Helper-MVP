NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local-only: allow in-memory helper rate limiting when the service-role client
# or RPC is unavailable. Requires NODE_ENV=development as well. Never set in
# production — production fails closed with 503 when durable RL is unavailable.
# HELPERS_ALLOW_MEMORY_RATE_LIMIT=1

# Server-only contact notification via the Resend HTTP API.
# CONTACT_NOTIFICATION_FROM must be a verified sender on that account.
RESEND_API_KEY=
CONTACT_NOTIFICATION_TO=admin@parentive.ca
CONTACT_NOTIFICATION_FROM=
